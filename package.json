{
  "name": "@webship.co/workspace-kanboard",
  "version": "1.0.0",
  "description": "Kanboard for Webship Workspace: the builder (`cmd-kanboard-project.sh`, a site of the open-source Kanban project management software, from Kanboard's own image on the project's own MariaDB, in containers: DDEV, with the default accounts in their roles of a sample project and its tasks in the board's columns) and its tool in every sites folder, the Kanboard step pack wired into the testing setup, the tasks of a Kanboard as work items of the tracker family (list, read, analyze, and do the work with the workspace's AI CLI on a branch; comments, moves on the board, tags and assignees after a person's click, writes off by default), and its AI items in their folders.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-kanboard.git"
  },
  "workspacePlugin": {
    "name": "kanboard",
    "label": "Kanboard",
    "summary": "A builder for Kanboard sites with a sample project and its board; its tasks as work items",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "typeActions": {
      "kanboard": [
        "sites",
        "code"
      ]
    },
    "settingsFile": "plugin.kanboard.settings.yml",
    "settingsTemplate": "config/plugin.kanboard.settings.yml",
    "labels": "config/settings.labels.yml",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-kanboard-project.sh",
        "commands/cmd-tools-kanboard-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-kanboard.sh"
      ],
      "args": [
        "scripts/args/arg-kanboard.sh",
        "scripts/args/arg-kanboard-cli.sh"
      ],
      "machine": [
        "scripts/docker-compose.kanboard.yaml",
        "scripts/kanboard-site.php",
        "scripts/kanboard-serve.sh",
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/kanboard-site-builder.md",
        "ai/agents/kanboard-tester.md",
        "ai/agents/kanboard-issue-worker.md"
      ],
      "skills": [
        "ai/skills/kanboard-scenarios"
      ],
      "commands": [
        "ai/commands/kanboard-test.md"
      ],
      "prompts": [
        "ai/prompts/kanboard-build-and-test.md",
        "ai/prompts/kanboard-issue-to-branch.md"
      ]
    },
    "features": [
      "features/kanboard.feature",
      "features/kanboard-runtimes.feature"
    ],
    "featuresSite": "cmd-kanboard-project.sh ci-kanboard --install --add-users --sample-content --runtime docker"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "config",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "dependencies": {
    "@webship.co/workspace-tracker": "^1.0.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.11",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
